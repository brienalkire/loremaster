# Copy this file to .env in your LOREMASTER_HOME folder (by default, the
# folder this file is in) and fill in the values. Never commit .env.

# --- Required ---------------------------------------------------------

# Discord bot token (Discord Developer Portal > your application > Bot)
DISCORD_BOT_TOKEN=

# Anthropic API key (console.anthropic.com > Settings > API Keys)
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------

# Claude model to use (default: see CLAUDE_MODEL in bot/main.py)
CLAUDE_MODEL=

# Game extension to use before any campaign is active: a folder name
# under instructions/. Leave blank to use the persona alone.
GAME_EXTENSION=

# Kokoro voice for spoken replies ("speak on"). Needs ffmpeg on PATH.
LOREMASTER_TTS_VOICE=bm_george

# --- Voice input (experimental, off by default) -----------------------
# Listening records people in the voice channel: tell your members first.
# Needs a Wyoming Whisper server running (see bot/README.md).
LOREMASTER_VOICE_INPUT=false
WHISPER_HOST=localhost
WHISPER_PORT=10300

# The word that wakes the bot in voice. It doesn't follow the bot's
# Discord name. If you change it, pick a distinctive word of three or more
# syllables that isn't an everyday word: short or common words wake the
# bot by accident, and Whisper mishears them more.
LOREMASTER_WAKE_WORD=loremaster
# Comma-separated extra spellings that Whisper tends to hear instead of the
# wake word. Blank means the default: "warmaster" for "loremaster", none
# for a custom wake word. Setting it replaces the default.
LOREMASTER_WAKE_WORD_ALIASES=
